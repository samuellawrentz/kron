{
  "packages": {
    "crates/kron-cli": {
      "release-type": "rust",
      "component": "kron"
    },
    "crates/kron-core": {
      "release-type": "rust",
      "component": "kron-core"
    },
    "crates/kron-store": {
      "release-type": "rust",
      "component": "kron-store"
    }
  },
  "plugins": [
    {
      "type": "cargo-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "kron",
      "components": ["kron", "kron-core", "kron-store"]
    }
  ]
}
